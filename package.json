{
  "name": "tamagotchi-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "데스크톱 타마고치 펫 — Electron 프로토타입",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "postinstall": "node scripts/rebuild-native.mjs && node scripts/fetch-fonts.mjs && node scripts/brand-dev-electron.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "test": "tsc --build && node --experimental-strip-types --test \"packages/*/test/**/*.test.ts\"",
    "build": "node scripts/fetch-fonts.mjs && npm run build --workspace @pet/main-overlay && npm run build:ui --workspace @pet/battle && tsc --build",
    "token:grant": "tsc --build && electron apps/desktop/dist/main/admin/grant-tokens-cli.js",
    "start": "npm run build && electron apps/desktop/dist/main/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.7.0"
  }
}
