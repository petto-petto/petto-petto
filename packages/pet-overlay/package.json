{
  "name": "@pet/main-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "메인 펫 오버레이와 성장 도메인",
  "scripts": {
    "generate:pets": "node scripts/generate-renderer-pet-catalog.mjs",
    "prebuild": "npm run generate:pets",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node src/growth/engine.test.mjs && node src/growth/controller.test.mjs && node --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "domain:build": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": "./dist/index.html"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.7"
  }
}
