{
  "name": "@pet/battle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Battle feature with an in-process Electron/TypeScript engine",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./ui": {
      "types": "./ui/index.html",
      "default": "./dist/ui/index.html"
    },
    "./ui/*": {
      "types": "./ui/*",
      "default": "./dist/ui/*"
    },
    "./assets/*": "./dist/ui/assets/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@pet/client": "*",
    "@pet/core": "*",
    "@pet/room": "*"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json && npm run build:ui",
    "build:ui": "node scripts/build-ui.mjs",
    "demo": "npm run build && electron dist/ui/demo-main.cjs",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:integration": "npm run build && node --test test/client-engine.integration.cjs",
    "test:electron": "npm run build && node test/run-electron-smoke.cjs"
  }
}
